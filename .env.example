# ── AI Customer Calling Agent — environment variable template ──
# Set variables in your shell or hosting provider. Never commit credentials.

# Neon pooled PostgreSQL URL; replace every placeholder.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Port the Flask dev server listens on
FLASK_PORT=5000

# Set to "true" to let the Flask reloader restart on code changes (dev only)
FLASK_DEBUG=true

# ── Gemini (OPTIONAL natural-language layer — OFF by default) ──
# When disabled, the app uses its deterministic assistant and everything works.
# Gemini only CLASSIFIES intent/language and rephrases our own approved text; it
# is NEVER a source of truth for order status (PostgreSQL) or policies (FAQ).
GEMINI_ENABLED=false

# Non-secret settings (safe to keep here):
GEMINI_MODEL=gemini-flash-latest
# Per-request timeout in seconds so a slow API can never hang the app:
GEMINI_TIMEOUT=10

# SECRET — set the real key in your process environment or hosting provider.
# Never commit it. The app reads it at runtime and never returns it to clients.
# GEMINI_API_KEY=your-key-here
