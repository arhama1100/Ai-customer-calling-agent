# ── AI Customer Calling Agent — environment config template ──
# Copy this file to ".env" and adjust values for your machine.
# The real ".env" is excluded from Git (see .gitignore).

# Port the Flask dev server listens on
FLASK_PORT=5000

# Set to "true" to let the Flask reloader restart on code changes (dev only)
FLASK_DEBUG=true

# ── Gemini (OPTIONAL natural-language layer — OFF by default) ──
# When disabled, the app uses its deterministic assistant and everything works.
# Gemini only CLASSIFIES intent/language and rephrases our own approved text; it
# is NEVER a source of truth for order status (SQLite) or policies (FAQ).
GEMINI_ENABLED=false

# Non-secret settings (safe to keep here):
GEMINI_MODEL=gemini-flash-latest
# Per-request timeout in seconds so a slow API can never hang the app:
GEMINI_TIMEOUT=10

# SECRET — put your real key ONLY in your local ".env" (never commit it).
# The app reads it from the environment at runtime and never logs or prints it.
# GEMINI_API_KEY=your-key-here
